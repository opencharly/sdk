# web.service (generated by charly config)
[Unit]
Description=charly deployment web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/nerdctl rm -f web
ExecStart=/usr/bin/nerdctl run --rm --name web --userns=keep-id:uid=1000,gid=1000 img
ExecStop=/usr/bin/nerdctl stop web
Environment=A=100%%
Environment="B=two words"
Environment=C=plain
WorkingDirectory=/home/u
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
