# nightly.service (generated by charly config)
[Unit]
Description=charly workflow nightly
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/charly -C /home/u/p/.opencharly/pipelines/nightly task _pipeline-nightly-run --output
Restart=no

[Install]
WantedBy=default.target
